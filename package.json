{
  "name": "bookboost-studio",
  "productName": "BookBoost Studio",
  "version": "1.0.0",
  "description": "A private book marketing studio for authors.",
  "author": "BookBoost Studio",
  "license": "UNLICENSED",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build:fast": "node scripts/build.mjs",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "electron .",
    "e2e": "node tests/e2e/smoke.mjs",
    "verify": "npm run build && npm test && npm run e2e",
    "dist": "npm run build && electron-builder --win nsis --x64",
    "dist:portable": "npm run build && electron-builder --win portable --x64",
    "dist:all": "npm run build && electron-builder --win nsis portable --x64"
  },
  "dependencies": {
    "sql.js": "1.16.0"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource/cormorant-garamond": "5.3.0",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.6.2",
    "electron": "45.3.1",
    "electron-builder": "26.18.0",
    "esbuild": "0.28.2",
    "lucide-react": "1.72.0",
    "playwright-core": "1.65.0",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "3.4.19",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.0",
    "zod": "4.6.7"
  },
  "engines": {
    "node": ">=22"
  }
}
